# Copy this file to  data/mail.env  and fill it in. data/ is not committed to git.
#
# Gmail: turn on 2-Step Verification for the Google account, then create an App Password
# at https://myaccount.google.com/apppasswords and paste the 16-character password below.
# (Your normal Gmail password will NOT work for SMTP.)

SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Optional. Defaults: smtp.gmail.com for Gmail addresses, port 587, from = SMTP_USER
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM=you@gmail.com
